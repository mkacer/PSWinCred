<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net462 is loaded by Windows PowerShell 5.1, netstandard2.0 by PowerShell 7+. -->
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <AssemblyName>StoredCredential</AssemblyName>
    <RootNamespace>PSCredentialManager</RootNamespace>
    <Product>StoredCredential</Product>
    <Description>Reads, writes and deletes credentials in the Windows Credential Manager</Description>
    <!-- Encoding converts passwords directly between unmanaged buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft's PowerShell reference assemblies, compile-time only. They are not shipped:
         PowerShell itself provides System.Management.Automation at run time. -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StoredCredential.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="StoredCredential.psd1;StoredCredential.psm1" />
  </ItemGroup>

</Project>
