<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net462 is loaded by Windows PowerShell 5.1, netstandard2.0 by PowerShell 7+. -->
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <AssemblyName>TUN.CredentialManager</AssemblyName>
    <RootNamespace>PSCredentialManager</RootNamespace>
    <Product>TUN.CredentialManager</Product>
    <Description>Provides access to credentials in the Windows Credential Manager</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft's PowerShell reference assemblies, compile-time only. They are not shipped:
         PowerShell itself provides System.Management.Automation at run time. -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TUN.CredentialManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TUN.CredentialManager.psd1;TUN.CredentialManager.psm1" />
  </ItemGroup>

</Project>
