<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net462 runs the Windows PowerShell 5.1 build, net10.0 the PowerShell 7 build. -->
    <TargetFrameworks>net462;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <!-- Windows PowerShell 5.1 supplies System.Management.Automation from the GAC at run time. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6" />
    <!-- Lift transitive packages of the PowerShell SDK past known advisories (test-only). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StoredCredential\StoredCredential.csproj" />
  </ItemGroup>

</Project>
