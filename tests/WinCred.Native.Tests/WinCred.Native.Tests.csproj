<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net462 runs the Windows PowerShell 5.1 build, net10.0 the PowerShell 7 build (net8.0). -->
    <TargetFrameworks>net462;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <!-- WinCred is Windows-only (CA1416), but these tests use a fake of the native API and run on any OS. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinCred\WinCred.csproj" />
  </ItemGroup>

</Project>
