<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net462 runs the Windows PowerShell 5.1 build, net10.0 the PowerShell 7 build (net8.0). -->
    <TargetFrameworks>net462;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft.Testing.Platform: the test project is its own executable; no VSTest host. -->
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <Nullable>enable</Nullable>
    <!-- WinCred is Windows-only (CA1416), but these tests use a fake of the native API and run on any OS. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Constant arrays in assertions are clearer than static fields; performance does not matter here. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
    <!-- No lock file: on Windows the net462 test executable also restores for win-x86, so a lock file differs by
         OS. The package versions are exact, and the tests are not shipped; the module's packages stay locked. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <!-- Keep in step with the Microsoft.Testing.Platform version MSTest uses. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinCred\WinCred.csproj" />
  </ItemGroup>

</Project>
